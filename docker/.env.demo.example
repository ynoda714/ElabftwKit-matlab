# Demonstration server settings. Copy to docker/.env.demo, then fill in the secrets.
# Use values different from docker/.env and pass this file with --env-file.
ELABFTW_PROJECT_NAME=elabftw-demo
ELABFTW_PORT=3149
ELABFTW_UPLOADS_VOLUME=elabftw-demo-uploads
ELABFTW_MYSQL_VOLUME=elabftw-demo-mysql-data
ELABFTW_SECRET_KEY=
ELABFTW_DB_PASSWORD=
ELABFTW_DB_ROOT_PASSWORD=
